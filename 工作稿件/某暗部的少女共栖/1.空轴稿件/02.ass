Dialogue: 1,0:05:54.75,0:05:58.59,对白 中文,Professor,0,0,0,,
Dialogue: 0,0:05:58.59,0:06:01.22,对白 日语,Professor,0,0,0,,良心の呵責くらいあるだろう? ヒヒ! フヒヒヒ!
Dialogue: 1,0:05:58.59,0:06:01.22,对白 中文,Professor,0,0,0,,
Comment: 1,0:05:58.59,0:06:01.22,Ruby,Professor,0,0,0,,
Dialogue: 0,0:06:01.67,0:06:03.76,对白 日语,Mugino,0,0,0,,なるほど そうきたか
Dialogue: 1,0:06:01.67,0:06:03.76,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:05.39,0:06:07.30,对白 日语,Security Guard E,0,0,0,,待ってくれ! 投降する!
Dialogue: 1,0:06:05.39,0:06:07.30,对白 中文,Security Guard E,0,0,0,,
Dialogue: 0,0:06:09.52,0:06:12.81,对白 日语,Mugino,0,0,0,,う～ん 悪いけど そういう依頼じゃないんだよね
Dialogue: 1,0:06:09.52,0:06:12.81,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:12.81,0:06:13.52,对白 日语,Professor,0,0,0,,いら…
Dialogue: 1,0:06:12.81,0:06:13.52,对白 中文,Professor,0,0,0,,
Dialogue: 0,0:06:13.81,0:06:17.15,对白 日语,Mugino,0,0,0,,もうすぐここに 正義のヒーローがやってくるから
Dialogue: 1,0:06:13.81,0:06:17.15,对白 中文,Mugino,0,0,0,,
Comment: 1,0:06:13.81,0:06:17.15,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:06:17.15,0:06:21.99,对白 日语,Mugino,0,0,0,,騒ぎになる前に表に出たら困る 証拠関係を焼き払え
Dialogue: 1,0:06:17.15,0:06:21.99,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:22.40,0:06:25.28,对白 日语,Mugino,0,0,0,,そういう真っ黒な依頼なの
Dialogue: 1,0:06:22.40,0:06:25.28,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:26.28,0:06:30.62,对白 日语,Mugino,0,0,0,,それには 人の頭の中にある 情報も含まれる
Dialogue: 1,0:06:26.28,0:06:30.62,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:34.92,0:06:35.79,对白 日语,Mugino,0,0,0,,悪いね どこぞの 精神系レベル5みたいに
Dialogue: 1,0:06:34.92,0:06:35.79,对白 中文,Mugino,0,0,0,,
Comment: 1,0:06:34.92,0:06:35.79,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:06:36.25,0:06:41.21,对白 日语,Mugino,0,0,0,,記憶だけ選んで消去できりゃあ
Dialogue: 1,0:06:36.25,0:06:41.21,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:41.21,0:06:45.55,对白 日语,Mugino,0,0,0,,クソったれの悪党も 人生 やり直せたかもしれないけど
Dialogue: 1,0:06:41.21,0:06:45.55,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:06:46.09,0:06:48.14,对白 日语,Takitsubo,0,0,0,,麦野 あっちに何かある
Dialogue: 1,0:06:46.09,0:06:48.14,对白 中文,Takitsubo,0,0,0,,
Dialogue: 0,0:06:48.97,0:06:51.18,对白 日语,Takitsubo,0,0,0,,緊急っぽい感じじゃないけど
Dialogue: 1,0:06:48.97,0:06:51.18,对白 中文,Takitsubo,0,0,0,,
Dialogue: 0,0:06:52.47,0:06:53.73,对白 日语,Frenda,0,0,0,,あれかな? 結局あれでしょ
Dialogue: 1,0:06:52.47,0:06:53.73,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:06:54.06,0:06:58.44,对白 日语,Frenda,0,0,0,,わざわざ部屋どころか入り口の ドアまで隠してあるわけだし
Dialogue: 1,0:06:54.06,0:06:58.44,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:06:58.44,0:07:00.36,对白 日语,Mugino,0,0,0,,じゃあ 5分ちょうだい
Dialogue: 1,0:06:58.44,0:07:00.36,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:07:00.36,0:07:02.90,对白 日语,Mugino,0,0,0,,ひとまず全部殺すまで待って
Dialogue: 1,0:07:00.36,0:07:02.90,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:07:07.49,0:07:11.62,对白 日语,Frenda,0,0,0,,だから結局 今のゲーム機って すごいんだよ!
Dialogue: 1,0:07:07.49,0:07:11.62,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:07:11.62,0:07:14.54,对白 日语,Frenda,0,0,0,,フィットネスとか 健康管理もしてくれんの!
Dialogue: 1,0:07:11.62,0:07:14.54,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:11.62,0:07:14.54,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:07:16.54,0:07:19.75,对白 日语,Mugino,0,0,0,,え～? 五つ星評価のジムと 契約したほうがよくない?
Dialogue: 1,0:07:16.54,0:07:19.75,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:07:19.75,0:07:22.30,对白 日语,Mugino,0,0,0,,ピラティスとかホットヨガとか
Dialogue: 1,0:07:19.75,0:07:22.30,对白 中文,Mugino,0,0,0,,
Comment: 1,0:07:19.75,0:07:22.30,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:07:22.30,0:07:23.38,对白 日语,Frenda,0,0,0,,チッチッチッ
Dialogue: 1,0:07:22.30,0:07:23.38,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:22.30,0:07:23.38,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:07:23.67,0:07:33.02,对白 日语,Frenda,0,0,0,,麦野! 結局そもそも ダイエットのための… あん? オホン! 大変お美しいオトナの ボディーメイクのために!
Dialogue: 1,0:07:23.67,0:07:33.02,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:23.67,0:07:33.02,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:07:33.02,0:07:38.73,对白 日语,Frenda,0,0,0,,それだけでわざわざ専用の時間を 割くっていうのが 結局もう無理めなわけよ
Dialogue: 1,0:07:33.02,0:07:38.73,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:07:38.73,0:07:42.11,对白 日语,Frenda,0,0,0,,ながらで効果が目にみえる ストレスフリーな感じにしないと
Dialogue: 1,0:07:38.73,0:07:42.11,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:38.73,0:07:42.11,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:07:42.11,0:07:44.23,对白 日语,Frenda,0,0,0,,こういうのって続かなくない?
Dialogue: 1,0:07:42.11,0:07:44.23,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:07:44.23,0:07:50.91,对白 日语,Frenda,0,0,0,,だから結局ほしいのは 小さなゲーム機に ワンセット全部入っちゃう よくできた体操ソフト!
Dialogue: 1,0:07:44.23,0:07:50.91,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:44.23,0:07:50.91,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:07:50.91,0:07:53.24,对白 日语,Mugino,0,0,0,,ちまちましたのは 苦手なんだよ!
Dialogue: 1,0:07:50.91,0:07:53.24,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:07:54.17,0:07:56.84,对白 日语,Mugino,0,0,0,推定,おっ?
Dialogue: 1,0:07:54.17,0:07:56.84,对白 中文,Mugino,0,0,0,推定,
Dialogue: 0,0:07:58.58,0:08:01.54,对白 日语,Frenda,0,0,0,,ふ～ん 結局 コールドスリープで固めてあったから
Dialogue: 1,0:07:58.58,0:08:01.54,对白 中文,Frenda,0,0,0,,
Comment: 1,0:07:58.58,0:08:01.54,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:08:01.54,0:08:04.38,对白 日语,Frenda,0,0,0,,心音や呼吸の反応が なかったんだね
Dialogue: 1,0:08:01.54,0:08:04.38,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:04.96,0:08:09.05,对白 日语,Mugino,0,0,0,,事前の資料どおり 全部 人間ロッカーか
Dialogue: 1,0:08:04.96,0:08:09.05,对白 中文,Mugino,0,0,0,,
Comment: 1,0:08:04.96,0:08:09.05,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:08:09.84,0:08:13.35,对白 日语,Frenda,0,0,0,,つまり 暗闇の 五月計画とかいうプロジェクトを
Dialogue: 1,0:08:09.84,0:08:13.35,对白 中文,Frenda,0,0,0,,
Comment: 1,0:08:09.84,0:08:13.35,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:08:13.35,0:08:15.85,对白 日语,Frenda,0,0,0,,安全に撤収させるための標的
Dialogue: 1,0:08:13.35,0:08:15.85,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:16.18,0:08:20.77,对白 日语,Frenda,0,0,0,,完全に無抵抗って ちょっと 鬱モードになりそうだけど
Dialogue: 1,0:08:16.18,0:08:20.77,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:22.69,0:08:25.32,对白 日语,Frenda,0,0,0,,どうする? 結局 全部爆破する?
Dialogue: 1,0:08:22.69,0:08:25.32,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:25.32,0:08:28.48,对白 日语,Mugino,0,0,0,,いや お土産にもらっていこう
Dialogue: 1,0:08:25.32,0:08:28.48,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:28.48,0:08:30.53,对白 日语,Mugino,0,0,0,,まぁ 1人もいれば十分だけど
Dialogue: 1,0:08:28.48,0:08:30.53,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:31.82,0:08:35.54,对白 日语,Frenda,0,0,0,,えっ 人も物も全部消し去れって 依頼じゃなかった?
Dialogue: 1,0:08:31.82,0:08:35.54,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:35.54,0:08:37.58,对白 日语,Mugino,0,0,0,,お行儀よく従う理由は?
Dialogue: 1,0:08:35.54,0:08:37.58,对白 中文,Mugino,0,0,0,,
Comment: 0,0:08:39.62,0:08:39.62,注释,,0,0,0,,p2
Dialogue: 0,0:08:39.62,0:08:42.58,对白 日语,Frenda,0,0,0,,いいけど 人助けなんて ぬるい話じゃないわけよね
Dialogue: 1,0:08:39.62,0:08:42.58,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:42.96,0:08:44.84,对白 日语,Frenda,0,0,0,,結局 本音はなに?
Dialogue: 1,0:08:42.96,0:08:44.84,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:08:44.84,0:08:47.17,对白 日语,Mugino,0,0,0,,じゃあ 理由の1個目
Dialogue: 1,0:08:44.84,0:08:47.17,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:47.17,0:08:50.84,对白 日语,Mugino,0,0,0,,上からの依頼は 公になったら まずいデータの抹消よ
Dialogue: 1,0:08:47.17,0:08:50.84,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:51.39,0:08:53.64,对白 日语,Mugino,0,0,0,,標的標的とは 書かれているけど
Dialogue: 1,0:08:51.39,0:08:53.64,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:53.64,0:08:56.60,对白 日语,Mugino,0,0,0,,実際問題 ここで何をやっていたのか
Dialogue: 1,0:08:53.64,0:08:56.60,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:08:56.60,0:09:00.94,对白 日语,Mugino,0,0,0,,具体的な数値まで 自分の口で説明できない
Dialogue: 1,0:08:56.60,0:09:00.94,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:00.94,0:09:02.77,对白 日语,Mugino,0,0,0,,受け身のガキどもは わりと どうでもいいはず
Dialogue: 1,0:09:00.94,0:09:02.77,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:03.48,0:09:05.02,对白 日语,Mugino,0,0,0,,依頼を思い出せよ
Dialogue: 1,0:09:03.48,0:09:05.02,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:05.82,0:09:09.19,对白 日语,Mugino,0,0,0,,研究者や警備チームは わりと問答無用だけど
Dialogue: 1,0:09:05.82,0:09:09.19,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:09.19,0:09:16.83,对白 日语,Mugino,0,0,0,,被験者については 言及なしだったでしょ ふ～ん 実は 必ずしも殺す縛りはない
Dialogue: 1,0:09:09.19,0:09:16.83,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:17.70,0:09:18.91,对白 日语,Frenda,0,0,0,,なるほど
Dialogue: 1,0:09:17.70,0:09:18.91,对白 中文,Frenda,0,0,0,,
Dialogue: 0,0:09:19.50,0:09:24.13,对白 日语,Mugino,0,0,0,,滝壺は貴重な照準係だけど 戦闘はできないのよね
Dialogue: 1,0:09:19.50,0:09:24.13,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:24.67,0:09:29.05,对白 日语,Mugino,0,0,0,,私のメルトダウナーは 殺傷力がでかすぎて
Dialogue: 1,0:09:24.67,0:09:29.05,对白 中文,Mugino,0,0,0,,
Comment: 1,0:09:24.67,0:09:29.05,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:09:29.05,0:09:30.94,对白 日语,Mugino,0,0,0,,防御に向かない そのへんカバーするために
Dialogue: 1,0:09:29.05,0:09:30.94,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:30.94,0:09:36.05,对白 日语,Mugino,0,0,0,,レベル0でも結構やるらしいって 話を聞いて フレンダを加えてみたけど
Dialogue: 1,0:09:30.94,0:09:36.05,对白 中文,Mugino,0,0,0,,
Comment: 1,0:09:30.94,0:09:36.05,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:09:36.05,0:09:39.27,对白 日语,Mugino,0,0,0,,あんたも専門は 格闘より爆弾でしょ
Dialogue: 1,0:09:36.05,0:09:39.27,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:41.14,0:09:43.65,对白 日语,Mugino,0,0,0,,やっぱり防御特化とは言いがたい
Dialogue: 1,0:09:41.14,0:09:43.65,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:43.65,0:09:47.32,对白 日语,Mugino,0,0,0,,そして ここには おいしい素材がそろっている
Dialogue: 1,0:09:43.65,0:09:47.32,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:47.32,0:09:51.40,对白 日语,Takitsubo,0,0,0,,麦野 そろそろ防御に向いた 能力者がほしいってこと?
Dialogue: 1,0:09:47.32,0:09:51.40,对白 中文,Takitsubo,0,0,0,,
Dialogue: 0,0:09:52.03,0:09:54.11,对白 日语,Mugino,0,0,0,,暗闇の五月計画
Dialogue: 1,0:09:52.03,0:09:54.11,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:09:54.99,0:10:00.37,对白 日语,Mugino,0,0,0,,学園都市 第1位 アクセラレータの思考パターンを
Dialogue: 1,0:09:54.99,0:10:00.37,对白 中文,Mugino,0,0,0,,
Comment: 1,0:09:54.99,0:10:00.37,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:10:00.37,0:10:02.71,对白 日语,Mugino,0,0,0,,後付けで移植された 人造の高位能力者たち
Dialogue: 1,0:10:00.37,0:10:02.71,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:10:03.42,0:10:11.55,对白 日语,Mugino,0,0,0,,まぁ どこまで あいつの能力をコピーできたかは 知らないけど? もし反射だけでも 持ってたらラッキーよね
Dialogue: 1,0:10:03.42,0:10:11.55,对白 中文,Mugino,0,0,0,,
Comment: 1,0:10:03.42,0:10:11.55,Ruby,Mugino,0,0,0,,
Dialogue: 0,0:10:11.55,0:10:14.55,对白 日语,Mugino,0,0,0,,あんたの盾役としては 悪くないレア度じゃない?
Dialogue: 1,0:10:11.55,0:10:14.55,对白 中文,Mugino,0,0,0,,
Dialogue: 0,0:10:18.56,0:10:21.73,对白 日语,Frenda,0,0,0,,え～っと プロジェクト全体で 一番の成功作は2人
Dialogue: 1,0:10:18.56,0:10:21.73,对白 中文,Frenda,0,0,0,,
Comment: 1,0:10:18.56,0:10:21.73,Ruby,Frenda,0,0,0,,
Comment: 0,0:10:21.77,0:10:28.40,Signs,Sign,0,0,0,,{\an7}SAIAI KINUHATA\NUMIDORI KUROYORU
Dialogue: 1,0:10:21.77,0:10:28.40,场面文本,Sign,0,0,0,,
Dialogue: 0,0:10:22.39,0:10:23.69,对白 日语,Frenda,0,0,0,,どっちもレベル4
Dialogue: 1,0:10:22.39,0:10:23.69,对白 中文,Frenda,0,0,0,,
Comment: 1,0:10:22.39,0:10:23.69,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:10:24.44,0:10:28.40,对白 日语,Frenda,0,0,0,,窒素で防御するオフェンスアーマーの 絹旗最愛と
Dialogue: 1,0:10:24.44,0:10:28.40,对白 中文,Frenda,0,0,0,,
Comment: 1,0:10:24.44,0:10:28.40,Ruby,Frenda,0,0,0,,
Dialogue: 0,0:10:28.40,0:10:33.24,对白 日语,Frenda,0,0,0,,窒素で攻撃する ボンバーランスの黒夜海鳥だって
Dialogue: 1,0:10:28.40,0:10:33.24,对白 中文,Frenda,0,0,0,,
